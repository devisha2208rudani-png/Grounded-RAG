RAG_SOURCE_DIR=./data/sample_docs
RAG_ARTIFACT_DIR=./.artifacts
RAG_CACHE_PATH=./.artifacts/cache.sqlite3
RAG_EMBEDDING_MODEL=intfloat/e5-base-v2
RAG_EMBEDDING_PROVIDER=sentence_transformer
RAG_LLM_MODEL=gpt-4.1-mini
RAG_LLM_BASE_URL=
RAG_LLM_API_KEY=
RAG_TOP_K=4
RAG_CANDIDATE_POOL_SIZE=8
RAG_CHUNK_SIZE=180
RAG_CHUNK_OVERLAP=40
RAG_HYBRID_ALPHA=0.6
RAG_ENABLE_RERANK=true
RAG_CONFIDENCE_THRESHOLD=0.28
RAG_LOG_LEVEL=INFO

